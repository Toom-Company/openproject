# Sparkfaktory Proyectos — copy to .env (chmod 600). Never commit .env.
# Generate secrets with: openssl rand -hex 32   (SECRET_KEY_BASE: openssl rand -hex 64)

# Image built from this fork (see docs/sparkfaktory/DESPLIEGUE.md). Pin a tag, never "latest".
SF_IMAGE=sparkfaktory/proyectos:17.9.6-sf.<commit>
# Bound to loopback only; Nginx on the host proxies to it. Check it is free: ss -ltn | grep 8090
SF_BIND=127.0.0.1:8090
# Prefix of the named volumes and network. Changing it means a new, empty installation.
SF_VOLUME_PREFIX=sparkfaktory_proyectos

# Database
POSTGRES_USER=sparkfaktory
POSTGRES_DB=sparkfaktory_proyectos
POSTGRES_PASSWORD=
DB_POOL=20

# Rails / OpenProject
SECRET_KEY_BASE=
OPENPROJECT_HOST__NAME=proyectos.sparkfaktory.com
OPENPROJECT_HTTPS=true
OPENPROJECT_HSTS=true
OPENPROJECT_SHOW__COMMUNITY__LINKS=false
OPENPROJECT_SEED_LOCALE=es
OPENPROJECT_WEB_WORKERS=0
OPENPROJECT_WEB_MAX__THREADS=8
RAILS_MIN_THREADS=4
RAILS_MAX_THREADS=8
OPENPROJECT_GOOD_JOB_MAX_THREADS=5
IMAP_ENABLED=false

# Generic seeded "admin" account: random password, forced reset; it is locked
# automatically once the named administrators below are created.
OPENPROJECT_SEED__ADMIN__USER__PASSWORD=
OPENPROJECT_SEED__ADMIN__USER__PASSWORD__RESET=true
OPENPROJECT_SEED__ADMIN__USER__MAIL=admin@proyectos.sparkfaktory.com
OPENPROJECT_SEED__ADMIN__USER__NAME="Administrador inicial"

# Named administrators created by `rake sparkfaktory:create_admins` (comma separated)
SPARKFAKTORY_ADMIN_EMAILS=

# Outgoing e-mail (SMTP)
OPENPROJECT_EMAIL__DELIVERY__METHOD=smtp
OPENPROJECT_MAIL__FROM=proyectos@sparkfaktory.com
OPENPROJECT_SMTP__ADDRESS=
OPENPROJECT_SMTP__PORT=587
OPENPROJECT_SMTP__DOMAIN=sparkfaktory.com
OPENPROJECT_SMTP__AUTHENTICATION=login
OPENPROJECT_SMTP__USER__NAME=
OPENPROJECT_SMTP__PASSWORD=
OPENPROJECT_SMTP__ENABLE__STARTTLS__AUTO=true
OPENPROJECT_SMTP__SSL=false

# Optional memory limits (defaults in docker-compose.yml)
# SF_WEB_MEM=1800m
# SF_WORKER_MEM=900m
# SF_DB_MEM=768m

# Escape hatches (leave unset): re-enable excluded modules / disable the route guard
# SPARKFAKTORY_REENABLE_MODULES=news,forums
# SPARKFAKTORY_DISABLE_ROUTE_GUARD=true
