# Example only — NOT installed. Copy to /etc/nginx/sites-available/, adjust, `nginx -t`,
# then enable it when the deployment is approved. Certificates via certbot (see DESPLIEGUE.md).
upstream sparkfaktory_proyectos {
    server 127.0.0.1:8090;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name proyectos.sparkfaktory.com;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name proyectos.sparkfaktory.com;

    ssl_certificate     /etc/letsencrypt/live/proyectos.sparkfaktory.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/proyectos.sparkfaktory.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 256m;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location / {
        proxy_pass http://sparkfaktory_proyectos;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
    }
}
