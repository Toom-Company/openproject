<%=
  widget_wrapper do |container|
    if projects.empty?
      container.with_body(classes: "op-widget-box--empty") do
        render(Primer::Beta::Blankslate.new(test_selector: "sf-projects-empty")) do |component|
          component.with_visual_icon(icon: :project)
          component.with_heading(tag: :h3).with_content(t("sparkfaktory.home.projects.empty"))
          if can_create?
            component.with_primary_action(href: helpers.new_project_path) { t("sparkfaktory.home.projects.new") }
          end
        end
      end
    else
      projects.each do |project|
        container.with_row(test_selector: "sf-project-item") do
          render(Primer::Beta::Link.new(href: helpers.project_path(project), font_weight: :bold,
                                        title: short_project_description(project))) { project.name }
        end
      end

      container.with_footer do
        helpers.flex_layout(justify_content: :space_between, flex_wrap: :wrap) do |row|
          row.with_column do
            render(Primer::Beta::Link.new(href: helpers.projects_path)) do
              t("sparkfaktory.home.projects.view_all", count: total)
            end
          end
          if can_create?
            row.with_column do
              render(Primer::Beta::Link.new(href: helpers.new_project_path)) { t("sparkfaktory.home.projects.new") }
            end
          end
        end
      end
    end
  end
%>
