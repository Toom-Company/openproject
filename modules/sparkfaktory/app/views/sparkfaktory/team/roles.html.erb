<%= render "sparkfaktory/team/header", selected: :roles %>

<%= render(Primer::Alpha::Banner.new(mb: 3, icon: :info)) { t("sparkfaktory.team.roles.admins_note") } %>

<% @summary.roles.each do |role| %>
  <%= render(Primer::Beta::BorderBox.new(mb: 4, test_selector: "sf-role-#{role.id}")) do |box| %>
    <% box.with_header do %>
      <%= render(Primer::Beta::Heading.new(tag: :h2, font_size: 3)) { role.name } %>
    <% end %>
    <% box.with_body do %>
      <% if (description = @summary.description(role)) %>
        <%= render(Primer::Beta::Text.new(tag: :p, color: :muted)) { description } %>
      <% end %>
      <%= render(Primer::Beta::Heading.new(tag: :h3, font_size: 5, mb: 2)) { t("sparkfaktory.team.roles.transitions") } %>
      <%= render "sparkfaktory/team/transitions", cells: @summary.transitions(role) %>
      <%= render(Primer::Beta::Heading.new(tag: :h3, font_size: 5, mt: 3, mb: 2)) { t("sparkfaktory.team.roles.permissions") } %>
      <%= render "sparkfaktory/team/permissions", role: %>
    <% end %>
  <% end %>
<% end %>

<% if current_user.admin? %>
  <% specialty_field = Sparkfaktory::Specialties.field %>
  <p>
    <% if @summary.type %>
      <%= link_to t("sparkfaktory.team.roles.edit_workflows"), edit_type_workflow_path(@summary.type) %> ·
    <% end %>
    <%= link_to t("sparkfaktory.team.roles.edit_roles"), roles_path %>
    <% if specialty_field %>
      · <%= link_to t("sparkfaktory.team.roles.edit_specialties"), edit_custom_field_path(specialty_field) %>
    <% end %>
  </p>
<% end %>
