<% html_title t("sparkfaktory.team.title") %>

<% content_for :content_header do %>
  <%=
    render(Primer::OpenProject::PageHeader.new) do |header|
      header.with_title { t("sparkfaktory.team.title") }
      header.with_description { t("sparkfaktory.team.description") }
      header.with_breadcrumbs([t("sparkfaktory.team.title")])

      specialty_field = Sparkfaktory::Specialties.field
      if current_user.admin? && specialty_field
        header.with_action_button(tag: :a, href: edit_custom_field_path(specialty_field),
                                  mobile_icon: :tag, mobile_label: t("sparkfaktory.team.specialties"),
                                  test_selector: "sf-specialties-link") do |button|
          button.with_leading_visual_icon(icon: :tag)
          t("sparkfaktory.team.specialties")
        end
      end

      if current_user.admin? && selected == :chart
        header.with_action_button(
          tag: :a, href: new_sparkfaktory_org_node_path, scheme: :primary,
          mobile_icon: :plus, mobile_label: t("sparkfaktory.team.add"),
          test_selector: "sf-org-add"
        ) do |button|
          button.with_leading_visual_icon(icon: :plus)
          t("sparkfaktory.team.add")
        end
      end

      header.with_tab_nav(label: nil) do |tab_nav|
        tab_nav.with_tab(selected: selected == :chart, href: sparkfaktory_team_path) do |tab|
          tab.with_text { t("sparkfaktory.team.tabs.chart") }
        end
        tab_nav.with_tab(selected: selected == :roles, href: sparkfaktory_team_roles_path) do |tab|
          tab.with_text { t("sparkfaktory.team.tabs.roles") }
        end
      end
    end
  %>
<% end %>
