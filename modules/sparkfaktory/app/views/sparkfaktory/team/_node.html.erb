<% principal = node.principal %>
<% children = node.preloaded_children %>
<li class="sf-org-chart--node">
  <div class="sf-org-card sf-org-card_depth-<%= [depth, 2].min %>" data-test-selector="sf-org-node-<%= node.id %>">
    <div class="sf-org-card--header">
      <span><%= node.title.presence || principal.name %></span>
      <% if current_user.admin? %>
        <%=
          render(Primer::Alpha::ActionMenu.new(anchor_align: :end)) do |menu|
            menu.with_show_button(
              icon: "kebab-horizontal", scheme: :invisible, size: :small,
              classes: "sf-org-card--menu", "aria-label": t("sparkfaktory.team.actions")
            )
            menu.with_item(label: t("sparkfaktory.team.add_below"), href: new_sparkfaktory_org_node_path(parent_id: node.id)) do |item|
              item.with_leading_visual_icon(icon: :plus)
            end
            menu.with_item(label: t(:button_edit), href: edit_sparkfaktory_org_node_path(node)) do |item|
              item.with_leading_visual_icon(icon: :pencil)
            end
            menu.with_item(
              label: t("sparkfaktory.team.remove"), scheme: :danger,
              href: sparkfaktory_org_node_path(node),
              form_arguments: { method: :delete,
                                data: { turbo_confirm: t("sparkfaktory.team.remove_confirm") } }
            ) do |item|
              item.with_leading_visual_icon(icon: :trash)
            end
          end
        %>
      <% end %>
    </div>

    <div class="sf-org-card--body">
      <% if node.group? %>
        <% if node.title.present? %>
          <strong class="sf-org-card--name"><%= principal.name %></strong>
        <% end %>
        <% if node.leaders.size > 1 %>
          <p class="sf-org-card--muted" data-test-selector="sf-org-leaders">
            <%= t("sparkfaktory.team.led_by", names: node.leaders.map(&:name).to_sentence) %>
          </p>
        <% end %>
        <% members = principal.users.active.order(:firstname, :lastname).to_a %>
        <% if members.empty? %>
          <p class="sf-org-card--muted"><%= t("sparkfaktory.team.no_members") %></p>
        <% else %>
          <p class="sf-org-card--muted"><%= t("sparkfaktory.team.member_count", count: members.size) %></p>
          <ul class="sf-org-card--members">
            <% members.each do |user| %>
              <li>
                <%= render "sparkfaktory/team/person", user:, size: :mini, leader: node.leaders.include?(user) %>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% else %>
        <%= render "sparkfaktory/team/person", user: principal, size: :medium, leader: false %>
      <% end %>
    </div>
  </div>

  <% if children.any? %>
    <ul class="sf-org-chart--level">
      <% children.each do |child| %>
        <%= render "sparkfaktory/team/node", node: child, depth: depth + 1 %>
      <% end %>
    </ul>
  <% end %>
</li>
