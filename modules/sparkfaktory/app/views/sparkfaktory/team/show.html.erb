<%= render "sparkfaktory/team/header", selected: :chart %>

<% if @roots.empty? %>
  <%=
    render(Primer::Beta::Blankslate.new(border: true, test_selector: "sf-org-empty")) do |component|
      component.with_visual_icon(icon: :organization)
      component.with_heading(tag: :h2).with_content(t("sparkfaktory.team.empty"))
      component.with_description { t(current_user.admin? ? "sparkfaktory.team.empty_admin" : "sparkfaktory.team.empty_user") }
    end
  %>
<% else %>
  <div class="sf-org-chart" data-test-selector="sf-org-chart">
    <ul class="sf-org-chart--level">
      <% @roots.each do |node| %>
        <%= render "sparkfaktory/team/node", node:, depth: 0 %>
      <% end %>
    </ul>
  </div>
<% end %>

<% if @unplaced_groups.present? %>
  <%=
    render(Primer::Beta::BorderBox.new(mt: 4, test_selector: "sf-org-unplaced")) do |box|
      box.with_header { t("sparkfaktory.team.unplaced") }
      @unplaced_groups.each do |group|
        box.with_row do
          flex_layout(justify_content: :space_between, align_items: :center) do |row|
            row.with_column { group.name }
            row.with_column do
              render(
                Primer::Beta::Button.new(
                  tag: :a, size: :small,
                  href: new_sparkfaktory_org_node_path(principal_id: group.id)
                )
              ) do
                t("sparkfaktory.team.place")
              end
            end
          end
        end
      end
    end
  %>
<% end %>
