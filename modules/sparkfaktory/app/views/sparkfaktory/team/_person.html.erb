<% open_tasks = @open_task_counts.fetch(user.id, 0) %>
<div class="sf-person" data-test-selector="sf-person-<%= user.id %>">
  <%= avatar(user, size: size) %>
  <div class="sf-person--info">
    <div class="sf-person--name">
      <%= link_to user.name, user_path(user), class: ("sf-org-card--name" if size == :medium) %>
      <% if leader %>
        <%= render(Primer::Beta::Label.new(scheme: :success)) { t("sparkfaktory.team.leader_label") } %>
      <% end %>
    </div>
    <% if user.mail.present? %>
      <%= mail_to user.mail, user.mail, class: "sf-person--mail" %>
    <% end %>
    <span class="sf-person--status <%= open_tasks.positive? ? "sf-person--status_active" : "" %>"
          data-test-selector="sf-person-status">
      <% if open_tasks.positive? %>
        <%= t("sparkfaktory.team.active", count: open_tasks) %>
      <% else %>
        <%= t("sparkfaktory.team.inactive") %>
      <% end %>
    </span>
    <%= render "sparkfaktory/team/specialties", user: %>
  </div>
</div>
