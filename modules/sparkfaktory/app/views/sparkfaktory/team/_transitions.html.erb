<ul class="sf-role-transitions">
  <% cells.each do |cell| %>
    <li class="sf-role-transitions--item <%= "sf-role-transitions--item_denied" unless cell.allowed? %>"
        data-test-selector="sf-transition-<%= cell.status.id %>">
      <%= render(
            Primer::Beta::Octicon.new(
              icon: cell.allowed? ? :check : :x,
              color: cell.allowed? ? :success : :muted
            )
          ) %>
      <strong><%= cell.status.name %></strong>
      <span class="sf-role-transitions--detail">
        <% if !cell.allowed? %>
          <%= t("sparkfaktory.team.roles.never") %>
        <% elsif cell.everywhere %>
          <%= t("sparkfaktory.team.roles.from_any") %>
        <% else %>
          <%= t("sparkfaktory.team.roles.from", statuses: cell.origins.map(&:name).to_sentence) %>
        <% end %>
      </span>
    </li>
  <% end %>
</ul>
